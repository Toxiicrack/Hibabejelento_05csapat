<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hibabejelento.Maui.Views.MainPage"
             Title="Hibabejelentő – Állapot">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Backend állapot"
                   FontSize="24" FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="12">
                <Ellipse Fill="{Binding StatusColor}"
                         WidthRequest="20" HeightRequest="20" />
                <Label Text="{Binding Status}" FontSize="20" />
            </HorizontalStackLayout>

            <Label Text="{Binding Database, StringFormat='Adatbázis: {0}'}" />
            <Label Text="{Binding Version, StringFormat='Verzió: {0}'}" />
            <Label Text="{Binding LastCheck, StringFormat='Utolsó ellenőrzés: {0:HH:mm:ss}'}" />

            <Button Text="Újraellenőrzés" Command="{Binding CheckHealthCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>