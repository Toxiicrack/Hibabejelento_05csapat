<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Hibabejelento.Maui.Views.MainPage"
    Title=""
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F6FA">

    <Grid Padding="15"
          RowDefinitions="Auto,*"
          RowSpacing="15">
        
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveStates">

                <VisualState x:Name="Portrait">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="PortraitView"
                                Property="IsVisible"
                                Value="True"/>
                        <Setter TargetName="SquareView"
                                Property="IsVisible"
                                Value="False"/>
                        <Setter TargetName="LandscapeView"
                                Property="IsVisible"
                                Value="False"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Square">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="700"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="PortraitView"
                                Property="IsVisible"
                                Value="False"/>
                        <Setter TargetName="SquareView"
                                Property="IsVisible"
                                Value="True"/>
                        <Setter TargetName="LandscapeView"
                                Property="IsVisible"
                                Value="False"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Landscape">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter TargetName="PortraitView"
                                Property="IsVisible"
                                Value="False"/>
                        <Setter TargetName="SquareView"
                                Property="IsVisible"
                                Value="False"/>
                        <Setter TargetName="LandscapeView"
                                Property="IsVisible"
                                Value="True"/>
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>


        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto,Auto,Auto,Auto"
              ColumnSpacing="10">

            <Border Grid.Column="0"
                    HeightRequest="42"
                    BackgroundColor="White"
                    Stroke="#E0E3EA"
                    StrokeShape="RoundRectangle 10"
                    Padding="12,0"
                    x:Name="SearchBorder">
                <Entry Placeholder="Hibajegyek keresése..."
                       Text="{Binding SearchText}"
                       FontSize="12"
                       VerticalOptions="Center" 
                       TextColor="Black"/>
            </Border>

            <Border Grid.Column="1"
                    HeightRequest="42"
                    BackgroundColor="White"
                    Stroke="#E0E3EA"
                    StrokeShape="RoundRectangle 10"
                    Padding="6,0">
                <Picker ItemsSource="{Binding StatusOptions}"
                        SelectedItem="{Binding SelectedStatus}"
                        FontSize="12"
                        TextColor="Black"
                        WidthRequest="120"
                        VerticalOptions="Center" />
            </Border>

            <Grid x:Name="LoggedInGrid"
                    Grid.Column="2"
                    Padding="10,0"
                    HeightRequest="42"
                    IsVisible="False" ColumnDefinitions="*,*">
                <Label Text="{Binding UserName}" Grid.Column="0" FontSize="12" TextColor="Black"/>
                <Button Grid.Column="1"
                        Text="Kijelentkezés"
                        FontSize="12"
                        HeightRequest="42"
                        Command="{Binding LogoutCommand}"/>
            </Grid>
            <Button Grid.Column="3"
                    Text="Bejelentkezés"
                    FontSize="12"
                    Padding="10,0"
                    HeightRequest="42"
                    x:Name="LoginButton"
                    Command="{Binding LoginCommand}"/>

            <Button Grid.Column="4"
                    Text="+ Új"
                    FontSize="12"
                    Padding="12,0"
                    HeightRequest="42"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    Command="{Binding CreateTicketCommand}"/>

        </Grid>


        <Grid Grid.Row="1">


            <CollectionView
                x:Name="PortraitView"
                IsVisible="True"
                ItemsSource="{Binding Tickets}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"                
                ItemSizingStrategy="MeasureAllItems">

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="30"
                        Spacing="10"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">

                        <Label Text="Nincsenek hibajegyek"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#374151"
                               HorizontalTextAlignment="Center"/>

                        <Label Text="A bejelentett hibajegyek itt fognak megjelenni."
                               FontSize="13"
                               TextColor="Gray"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border BackgroundColor="White"
                                Stroke="#E1E5EC"
                                StrokeShape="RoundRectangle 12"
                                Padding="15"
                                Margin="0,0,0,12">

                            <VerticalStackLayout Spacing="9">

                                <Grid ColumnDefinitions="*,Auto">

                                    <Label Text="{Binding TicketNumber}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#2563EB"/>

                                    <Label Grid.Column="1"
                                           Text="{Binding Priority}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#DC2626"/>
                                </Grid>

                                <Label Text="{Binding Title}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937"/>

                                <Label Text="{Binding Description}"
                                       FontSize="13"
                                       TextColor="#6B7280"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"/>

                                <Grid ColumnDefinitions="*,*"
                                      RowDefinitions="Auto,Auto"
                                      RowSpacing="8">

                                    <Label Text="{Binding CategoryName,
                                        StringFormat='Kategória: {0}'}"
                                           FontSize="12"
                                           TextColor="#4B5563"/>

                                    <Label Grid.Column="1"
                                           Text="{Binding Status}"
                                           FontSize="12"
                                           TextColor="#2563EB"/>

                                    <Label Grid.Row="1"
                                           Text="{Binding ReporterId,
                                           StringFormat='Bejelentő ID: {0}'}"
                                           FontSize="12"
                                           TextColor="#6B7280"/>

                                    <Label Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding DueDate,
                                           StringFormat='Határidő: {0:yyyy.MM.dd}'}"
                                           FontSize="12"
                                           TextColor="#6B7280"/>
                                </Grid>

                                <Label Text="{Binding Location,
                                       StringFormat='Helyszín: {0}'}"
                                       FontSize="12"
                                       TextColor="#6B7280"/>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>



            <CollectionView
                x:Name="SquareView"
                IsVisible="False"
                ItemsSource="{Binding Tickets}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"
                ItemSizingStrategy="MeasureAllItems">

                <CollectionView.EmptyView>
                    <Label Text="Nincsenek hibajegyek."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border BackgroundColor="White"
                                Stroke="#E1E5EC"
                                StrokeShape="RoundRectangle 8"
                                Padding="12"
                                Margin="0,0,0,8">

                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="6">

                                <Label Text="{Binding TicketNumber}"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       TextColor="#2563EB"/>

                                <Label Grid.Column="1"
                                       Text="{Binding Priority}"
                                       FontSize="12"
                                       TextColor="#DC2626"/>

                                <Label Grid.Row="1"
                                       Text="{Binding Title}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937"/>

                                <Label Grid.Row="2"
                                       Text="{Binding Status}"
                                       FontSize="12"
                                       TextColor="#2563EB"/>

                                <Label Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{Binding CreatedAt,
                                       StringFormat='{0:yyyy.MM.dd}'}"
                                       FontSize="12"
                                       TextColor="Gray"/>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>



            <CollectionView
                x:Name="LandscapeView"
                IsVisible="False"
                ItemsSource="{Binding Tickets}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedTicket, Mode=TwoWay}"
                ItemSizingStrategy="MeasureAllItems">

                <CollectionView.EmptyView>
                    <Label Text="Nincsenek hibajegyek."
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray"/>
                </CollectionView.EmptyView>

                <CollectionView.Header>
                    <Border BackgroundColor="#E9EDF5"
                            Stroke="#D5DAE4"
                            Padding="8">

                        <Grid ColumnDefinitions="2*,2*,2*,1.2*,1.2*,1.5*">

                            <Label Text="Azonosító"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="Black"/>

                            <Label Grid.Column="1"
                                   Text="Megnevezés"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="Black"/>

                            <Label Grid.Column="2"
                                   Text="Prioritás"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="Black"/>

                            <Label Grid.Column="3"
                                   Text="Státusz"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="Black"/>

                            <Label Grid.Column="4"
                                   Text="Bejelentő"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="Black"/>

                            <Label Grid.Column="5"
                                   Text="Határidő"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="Black"/>

                        </Grid>
                    </Border>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border BackgroundColor="White"
                                Stroke="#E1E5EC"
                                Padding="8">

                            <Grid ColumnDefinitions="2*,2*,2*,1.2*,1.2*,1.5*">

                                <Label Text="{Binding TicketNumber}"
                                       FontSize="12"
                                       TextColor="#2563EB"
                                       VerticalOptions="Center"/>

                                <Label Grid.Column="1"
                                       Text="{Binding Title}"
                                       FontSize="12"
                                       TextColor="#1F2937"
                                       VerticalOptions="Center"/>

                                <Label Grid.Column="2"
                                       Text="{Binding Priority}"
                                       FontSize="12"
                                       TextColor="#DC2626"
                                       VerticalOptions="Center"/>

                                <Label Grid.Column="3"
                                       Text="{Binding Status}"
                                       FontSize="12"
                                       TextColor="#2563EB"
                                       VerticalOptions="Center"/>

                                <Label Grid.Column="4"
                                       Text="{Binding ReporterId}"
                                       FontSize="12"
                                       TextColor="#4B5563"
                                       VerticalOptions="Center"/>

                                <Label Grid.Column="5"
                                       Text="{Binding DueDate,
                                       StringFormat='{0:yyyy.MM.dd}'}"
                                       FontSize="12"
                                       TextColor="#4B5563"
                                       VerticalOptions="Center"/>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

    </Grid>
</ContentPage>
