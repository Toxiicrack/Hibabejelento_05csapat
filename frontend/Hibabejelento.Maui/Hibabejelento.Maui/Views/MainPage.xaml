<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hibabejelento.Maui.Views.MainPage"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.1*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="0.1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="10" Margin="0,20,0,0">
            <Border
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 10"
                Grid.Row="1"
                Grid.Column="1"
                HeightRequest="50">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CardStates">
                        <VisualState x:Name="Portrait">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter TargetName="FS" Property="VisualElement.IsVisible" Value="False" />
                                <Setter TargetName="SS" Property="VisualElement.IsVisible" Value="False" />
                                <Setter TargetName="TS" Property="VisualElement.IsVisible" Value="True" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Square">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="700"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter TargetName="FS" Property="VisualElement.IsVisible" Value="False" />
                                <Setter TargetName="SS" Property="VisualElement.IsVisible" Value="True" />
                                <Setter TargetName="TS" Property="VisualElement.IsVisible" Value="False" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Landscape">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1000"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter TargetName="FS" Property="VisualElement.IsVisible" Value="True" />
                                <Setter TargetName="SS" Property="VisualElement.IsVisible" Value="False" />
                                <Setter TargetName="TS" Property="VisualElement.IsVisible" Value="False" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid>
                    <CollectionView ItemsLayout="HorizontalList" x:Name="FS"  IsVisible="True" ItemsSource="{Binding Tickets}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,*,*,*,*,*,*">
                                    <Label Text="{Binding TicketNumber}" Grid.Column="0"/>
                                    <Label Text="{Binding Priority}" Grid.Column="1"/>
                                    <Label Text="{Binding ReporterId}" Grid.Column="2"/>
                                    <Label Text="{Binding Title}" Grid.Column="3"/>
                                    <Label Text="{Binding AssignedUserId}" Grid.Column="4"/>
                                    <Label Text="{Binding Description}" Grid.Column="5"/>
                                    <Label Text="{Binding DueDate}" Grid.Column="6"/>

                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <CollectionView ItemsLayout="HorizontalList" x:Name="SS"  IsVisible="True">
                        <CollectionView.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>INC0001</x:String>
                                <x:String>URGENT</x:String>
                                <x:String>Sanyi</x:String>
                                <x:String>IT GUY</x:String>
                                <x:String>Windows hiba</x:String>
                                <x:String>STATUS</x:String>
                                <x:String>2026.10.16</x:String>
                            </x:Array>
                        </CollectionView.ItemsSource>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <FlexLayout Padding="5" Margin="5" JustifyContent="Center" HorizontalOptions="Center">
                                    <Label Text="{Binding .}" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </FlexLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <CollectionView ItemsLayout="HorizontalList" x:Name="TS"  IsVisible="True">
                        <CollectionView.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Sanyi</x:String>
                                <x:String>IT GUY</x:String>
                                <x:String>Windows hiba</x:String>
                                <x:String>STATUS</x:String>
                                <x:String>2026.10.16</x:String>
                            </x:Array>
                        </CollectionView.ItemsSource>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <FlexLayout Padding="5" Margin="5" JustifyContent="Center" HorizontalOptions="Center">
                                    <Label Text="{Binding .}" TextColor="Black" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </FlexLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </Grid>
            </Border>
        </VerticalStackLayout>
        
        <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="30"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ResponsiveSearchBar"
               WidthRequest="360"
               HeightRequest="30"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               BackgroundColor="Gray"
               StrokeShape="RoundRectangle 10"               
               Grid.Column="1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GlobalSearchCommand}"/>
                </Border.GestureRecognizers>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CardStates">
                        <VisualState x:Name="Portrait">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Property="HorizontalOptions" Value="Center"/>
                                <Setter Property="WidthRequest" Value="120"/>
                            </VisualState.Setters>
                        </VisualState>


                        <VisualState x:Name="Square">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="700"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Property="HorizontalOptions" Value="Center"/>
                                <Setter Property="WidthRequest" Value="240"/>
                            </VisualState.Setters>
                        </VisualState>

                        <VisualState x:Name="Landscape">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1000"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Property="HorizontalOptions" Value="End"/>
                            </VisualState.Setters>
                        </VisualState>

                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Label
                   Text="Search"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
            </Border>
            <Border x:Name="FilterBorder"
                    WidthRequest="30"
                    HeightRequest="30"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    BackgroundColor="Gray"
                    StrokeShape="RoundRectangle 15"                    
                    Grid.Column="2">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding LoginCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="L" HorizontalOptions="Center" VerticalOptions="Center"></Label>
            </Border>
            <Border x:Name="CreateIncidentBorder"
    WidthRequest="30"
    HeightRequest="30"
    HorizontalOptions="End"
    VerticalOptions="Center"
    BackgroundColor="Gray"
    StrokeShape="RoundRectangle 15"    
    Grid.Column="3">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CreateTicketCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="C" HorizontalOptions="Center" VerticalOptions="Center"></Label>
            </Border>
        </Grid>

    </Grid>
</ContentPage>