<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hibabejelento.Maui.Views.LoginPage"
             Title="LoginPage">
    <VerticalStackLayout>
        <Entry Text="{Binding UserEmail}" Placeholder="Email cím"/>
        <Entry Text="{Binding UserPwd}" Placeholder="Jelszó"/>
        <Button Command="{Binding LoginCommand}" Text="Bejelentkezés"/>
        <Label Text="{Binding UserError}" TextColor="Red" HorizontalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>