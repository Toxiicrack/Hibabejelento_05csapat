<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hibabejelento.Maui.Views.TicketEditPage"
             Title="Karbantartói munkalap"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#EEF2F6">

    <ScrollView>
        <Grid Padding="16"
              RowDefinitions="Auto, *"
              RowSpacing="14"
              MaximumWidthRequest="1560"
              HorizontalOptions="Fill">

            <Border Grid.Row="0"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    Padding="16,12">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <Border BackgroundColor="#EEF2FF"
                                Stroke="#C7D2FE"
                                StrokeShape="RoundRectangle 6"
                                Padding="10,4"
                                VerticalOptions="Center">
                            <Label Text="{Binding SelectedTicket.TicketNumber}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#4338CA"
                                   VerticalOptions="Center"/>
                        </Border>

                        <Label Text="{Binding SelectedTicket.Title}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Button Grid.Column="1"
                            Text="Hibajegy átvétele"
                            Command="{Binding TakeTicketCommand}"
                            IsVisible="{Binding CanTakeTicket}"
                            BackgroundColor="#4F46E5"
                            TextColor="White"
                            FontSize="12"
                            FontAttributes="Bold"
                            HeightRequest="36"
                            Padding="16,0"
                            CornerRadius="8"/>

                    <Button Grid.Column="2"
                            Text="✕"
                            Command="{Binding CloseCommand}"
                            BackgroundColor="#F1F5F9"
                            TextColor="#475569"
                            FontSize="13"
                            FontAttributes="Bold"
                            HeightRequest="36"
                            WidthRequest="36"
                            CornerRadius="8"
                            Padding="0"/>
                </Grid>
            </Border>

            <Grid x:Name="ContentGrid"
                  Grid.Row="1"
                  ColumnDefinitions="1.5*, 1*"
                  ColumnSpacing="16"
                  RowSpacing="14"
                  VerticalOptions="Start">

                <Grid x:Name="LeftRailGrid"
                      Grid.Column="0"
                      RowDefinitions="Auto, Auto, Auto"
                      RowSpacing="14">

                    <Border x:Name="TicketSummaryCard"
                            Grid.Row="0"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12"
                            Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="JEGYADATOK"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.8"
                                       TextColor="#64748B"
                                       VerticalOptions="Center"/>

                                <Border Grid.Column="1"
                                        BackgroundColor="#EEF2FF"
                                        Stroke="#C7D2FE"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="10,3">
                                    <Label Text="{Binding SelectedTicket.Status}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#4338CA"/>
                                </Border>
                            </Grid>

                            <Label Text="{Binding SelectedTicket.Description}"
                                   FontSize="13"
                                   TextColor="#334155"
                                   LineBreakMode="WordWrap"/>

                            <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" Margin="0,2"/>

                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="6"
                                  ColumnSpacing="14">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding SelectedTicket.Location, StringFormat='Helyszín: {0}'}"
                                       FontSize="12" TextColor="#334155"/>
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding SelectedTicket.Priority, StringFormat='Prioritás: {0}'}"
                                       FontSize="12" TextColor="#DC2626" FontAttributes="Bold"
                                       HorizontalTextAlignment="End"/>

                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding SelectedTicket.CategoryName, StringFormat='Kategória: {0}'}"
                                       FontSize="12" TextColor="#475569"/>
                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding SelectedTicket.GroupName, StringFormat='Csoport: {0}', TargetNullValue='Csoport: nincs'}"
                                       FontSize="12" TextColor="#475569" HorizontalTextAlignment="End"/>

                                <Label Grid.Row="2" Grid.Column="0"
                                       Text="{Binding SelectedTicket.ReporterName, StringFormat='Bejelentő: {0}'}"
                                       FontSize="12" TextColor="#64748B"/>
                                <Label Grid.Row="2" Grid.Column="1"
                                       Text="{Binding SelectedTicket.DueDate, StringFormat='Határidő: {0:yyyy.MM.dd}'}"
                                       FontSize="12" TextColor="#64748B" HorizontalTextAlignment="End"/>
                            </Grid>

                            <Label Text="{Binding SelectedTicket.AssignedUserName, StringFormat='Felelős karbantartó: {0}', TargetNullValue='Felelős karbantartó: nincs hozzárendelve'}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="WorkflowEditCard"
                            Grid.Row="1"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12"
                            Padding="16"
                            IsVisible="{Binding CanEditTicket}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="SZERKESZTÉS ÉS KIOSZTÁS"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.8"
                                       TextColor="#4F46E5"
                                       VerticalOptions="Center"/>
                                <Border Grid.Column="1"
                                        IsVisible="{Binding IsCurrentUserAdmin}"
                                        BackgroundColor="#FEF3C7"
                                        Stroke="#FDE68A"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="8,3">
                                    <Label Text="ADMIN" FontSize="10" FontAttributes="Bold" TextColor="#B45309"/>
                                </Border>
                            </Grid>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Cím" FontSize="11" FontAttributes="Bold" TextColor="#475569"/>
                                <Entry Text="{Binding EditTitle}"
                                       Placeholder="Hibajegy címe..."
                                       FontSize="13"
                                       MinimumHeightRequest="42"
                                       BackgroundColor="#F8FAFC"
                                       TextColor="#0F172A"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Leírás" FontSize="11" FontAttributes="Bold" TextColor="#475569"/>
                                <Editor Text="{Binding EditDescription}"
                                        Placeholder="Hibajegy leírása..."
                                        FontSize="13"
                                        HeightRequest="96"
                                        BackgroundColor="#F8FAFC"
                                        TextColor="#0F172A"/>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Kategória" FontSize="11" FontAttributes="Bold" TextColor="#475569"/>
                                    <Border BackgroundColor="#F8FAFC"
                                            Stroke="#CBD5E1"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="10,2">
                                        <Picker Title="Válassz kategóriát..."
                                                ItemsSource="{Binding Categories}"
                                                ItemDisplayBinding="{Binding Name}"
                                                SelectedItem="{Binding SelectedCategory}"
                                                FontSize="12"
                                                MinimumHeightRequest="40"
                                                BackgroundColor="Transparent"
                                                TextColor="#0F172A"/>
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Helyszín" FontSize="11" FontAttributes="Bold" TextColor="#475569"/>
                                    <Border BackgroundColor="#F8FAFC"
                                            Stroke="#CBD5E1"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="10,2">
                                        <Picker Title="Válassz helyszínt..."
                                                ItemsSource="{Binding Locations}"
                                                ItemDisplayBinding="{Binding Name}"
                                                SelectedItem="{Binding SelectedLocation}"
                                                FontSize="12"
                                                MinimumHeightRequest="40"
                                                BackgroundColor="Transparent"
                                                TextColor="#0F172A"/>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Prioritás" FontSize="11" FontAttributes="Bold" TextColor="#475569"/>
                                    <Border BackgroundColor="#F8FAFC"
                                            Stroke="#CBD5E1"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="10,2">
                                        <Picker Title="Válassz prioritást..."
                                                ItemsSource="{Binding Priorities}"
                                                SelectedItem="{Binding SelectedPriority}"
                                                FontSize="12"
                                                MinimumHeightRequest="40"
                                                BackgroundColor="Transparent"
                                                TextColor="#0F172A"/>
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Felelős ID" FontSize="11" FontAttributes="Bold" TextColor="#475569"/>
                                    <Entry Text="{Binding AssigneeUserIdInput}"
                                           Placeholder="Pl. 12"
                                           Keyboard="Numeric"
                                           FontSize="13"
                                           MinimumHeightRequest="42"
                                           BackgroundColor="#F8FAFC"
                                           TextColor="#0F172A"/>
                                </VerticalStackLayout>
                            </Grid>

                            <Button Text="Módosítások és kiosztás mentése"
                                    Command="{Binding SaveTicketEditsCommand}"
                                    BackgroundColor="#4F46E5"
                                    TextColor="White"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    HeightRequest="42"
                                    CornerRadius="8"
                                    Margin="0,4,0,0"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12"
                            Padding="16"
                            IsVisible="{Binding CanCloseTicket}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="HIBAJEGY LEZÁRÁSA"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.8"
                                   TextColor="#15803D"/>

                            <Grid ColumnDefinitions="*,1.4*,Auto" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        BackgroundColor="#F8FAFC"
                                        Stroke="#CBD5E1"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="8,2">
                                    <Picker Title="Lezárás típusa..."
                                            ItemsSource="{Binding ClosureTypes}"
                                            SelectedIndex="{Binding SelectedClosureTypeIndex, Mode=TwoWay}"
                                            FontSize="12"
                                            MinimumHeightRequest="38"
                                            BackgroundColor="Transparent"
                                            TextColor="#0F172A"/>
                                </Border>

                                <Entry Grid.Column="1"
                                       Text="{Binding Resolution}"
                                       Placeholder="Megoldás leírása (kötelező)..."
                                       FontSize="12"
                                       MinimumHeightRequest="40"
                                       BackgroundColor="#F8FAFC"
                                       TextColor="#0F172A"/>

                                <Button Grid.Column="2"
                                        Text="Lezárás"
                                        Command="{Binding CloseTicketCommand}"
                                        BackgroundColor="#16A34A"
                                        TextColor="White"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        HeightRequest="40"
                                        Padding="14,0"
                                        CornerRadius="8"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid x:Name="RightRailGrid"
                      Grid.Column="1"
                      RowDefinitions="Auto, *"
                      RowSpacing="14">

                    <Border x:Name="NotesCard"
                            Grid.Row="0"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12"
                            Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="JEGYZETEK ÉS KOMMUNIKÁCIÓ"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.8"
                                       TextColor="#475569"
                                       VerticalOptions="Center"/>

                                <Button Grid.Column="1"
                                        Text="↻ Frissítés"
                                        Command="{Binding LoadNotesAsyncCommand}"
                                        BackgroundColor="#F1F5F9"
                                        TextColor="#4F46E5"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        HeightRequest="28"
                                        Padding="10,0"
                                        CornerRadius="6"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8"
                                  IsVisible="{Binding CanAddNote}">
                                <Entry Grid.Column="0"
                                       Text="{Binding NewNote}"
                                       Placeholder="Új jegyzet írása a hibajegyhez..."
                                       FontSize="12"
                                       MinimumHeightRequest="40"
                                       BackgroundColor="#F8FAFC"
                                       TextColor="#0F172A"/>

                                <Button Grid.Column="1"
                                        Text="+ Jegyzet"
                                        Command="{Binding AddNoteCommand}"
                                        BackgroundColor="#0284C7"
                                        TextColor="White"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        HeightRequest="40"
                                        Padding="14,0"
                                        CornerRadius="8"/>
                            </Grid>

                            <CollectionView ItemsSource="{Binding Notes}"
                                            MaximumHeightRequest="280">
                                <CollectionView.EmptyView>
                                    <Label Text="Még nem érkezett munkabejegyzés ehhez a jegyhez."
                                           FontSize="12"
                                           TextColor="#94A3B8"
                                           Margin="0,12"/>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#F8FAFC"
                                                Stroke="#E2E8F0"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="10,8"
                                                Margin="0,0,0,8">
                                            <VerticalStackLayout Spacing="3">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="{Binding UserName}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="#0F172A"/>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding CreatedAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}"
                                                           FontSize="10"
                                                           TextColor="#94A3B8"/>
                                                </Grid>
                                                <Label Text="{Binding Message}"
                                                       TextColor="#334155"
                                                       FontSize="12"
                                                       LineBreakMode="WordWrap"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="StatusHistoryCard"
                            Grid.Row="1"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12"
                            Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="STÁTUSZELŐZMÉNYEK"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.8"
                                   TextColor="#64748B"/>

                            <CollectionView ItemsSource="{Binding StatusHistory}"
                                            MaximumHeightRequest="260">
                                <CollectionView.EmptyView>
                                    <Label Text="Nincs elérhető előzmény."
                                           FontSize="12"
                                           TextColor="#94A3B8"/>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#F8FAFC"
                                                Stroke="#E2E8F0"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="10,8"
                                                Margin="0,0,0,8">
                                            <VerticalStackLayout Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Text="{Binding TransitionDisplay}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="#0F172A"/>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding CreatedAt, StringFormat='{0:MM.dd HH:mm}'}"
                                                           FontSize="11"
                                                           TextColor="#94A3B8"/>
                                                </Grid>
                                                <Label Text="{Binding ChangedByUserName, StringFormat='Módosította: {0}'}"
                                                       FontSize="11"
                                                       TextColor="#64748B"/>
                                                <Label Text="{Binding Reason}"
                                                       FontSize="11"
                                                       TextColor="#475569"
                                                       LineBreakMode="WordWrap"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>