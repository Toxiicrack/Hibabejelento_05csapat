<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hibabejelento.Maui.Views.TicketDetailsPage"
             Title="Hibajegy részletei"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#EEF2F6">

    <ScrollView>
        <Grid Padding="16"
              RowDefinitions="Auto, *"
              RowSpacing="14"
              MaximumWidthRequest="1480"
              HorizontalOptions="Fill">

            <Border Grid.Row="0"
                    BackgroundColor="#4F46E5"
                    Stroke="#4338CA"
                    StrokeShape="RoundRectangle 14"
                    Padding="20,14">
                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <Border BackgroundColor="#3730A3"
                                Stroke="#6366F1"
                                StrokeShape="RoundRectangle 6"
                                Padding="10,4"
                                VerticalOptions="Center">
                            <Label Text="{Binding SelectedTicket.TicketNumber}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   VerticalOptions="Center"/>
                        </Border>

                        <Label Text="{Binding SelectedTicket.Title}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="White"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    

                    <Button Grid.Column="2"
                            Text="✕"
                            Command="{Binding CloseCommand}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="#3730A3"
                            HeightRequest="34"
                            WidthRequest="34"
                            Padding="0"
                            CornerRadius="8"
                            VerticalOptions="Center"/>
                </Grid>
            </Border>

            <Grid x:Name="ContentGrid"
                  Grid.Row="1"
                  ColumnDefinitions="1.1*, 1.9*"
                  ColumnSpacing="16"
                  RowSpacing="14"
                  VerticalOptions="Start">

                <VerticalStackLayout x:Name="LeftColumn"
                                     Grid.Column="0"
                                     Spacing="12">

                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12"
                            Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="STÁTUSZ"
                                       FontSize="10"
                                       TextColor="#94A3B8"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.6"
                                       VerticalOptions="Center"/>
                                <Border Grid.Column="1"
                                        BackgroundColor="#EEF2FF"
                                        Stroke="#C7D2FE"
                                        Padding="10,3"
                                        StrokeShape="RoundRectangle 6">
                                    <Label Text="{Binding SelectedTicket.Status}"
                                           FontSize="11"
                                           TextColor="#4338CA"
                                           FontAttributes="Bold"/>
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="#F1F5F9"/>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="PRIORITÁS" FontSize="9" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                    <Label Text="{Binding SelectedTicket.Priority}" FontSize="13" TextColor="#DC2626" FontAttributes="Bold"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="KATEGÓRIA" FontSize="9" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                    <Label Text="{Binding SelectedTicket.CategoryName}" FontSize="13" TextColor="#0F172A" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="BEJELENTŐ" FontSize="9" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                    <Label Text="{Binding ReporterDisplayName}"
                                           FontSize="13"
                                           TextColor="#0F172A"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="HATÁRIDŐ" FontSize="9" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                    <Label Text="{Binding SelectedTicket.DueDate, StringFormat='{0:yyyy.MM.dd}'}"
                                           FontSize="13"
                                           TextColor="#0F172A"/>
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="CSOPORT" FontSize="9" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                    <Label Text="{Binding SelectedTicket.GroupName, TargetNullValue='Nincs'}"
                                           FontSize="12"
                                           TextColor="#334155"
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="FELELŐS" FontSize="9" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                    <Label Text="{Binding SelectedTicket.AssignedUserName, TargetNullValue='Nincs kiosztva'}"
                                           FontSize="12"
                                           TextColor="#334155"
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="8">
                        <Button Text="Hibajegy visszavonása"
                                Command="{Binding WithdrawTicketCommand}"
                                IsVisible="{Binding CanWithdraw}"
                                BackgroundColor="#FEF2F2"
                                TextColor="#DC2626"
                                BorderColor="#FCA5A5"
                                BorderWidth="1"
                                FontSize="12"
                                FontAttributes="Bold"
                                HeightRequest="40"
                                CornerRadius="8"/>

                        <Button Text="Hibajegy újranyitása"
                                Command="{Binding ReopenTicketCommand}"
                                IsVisible="{Binding CanReopen}"
                                BackgroundColor="#FFFBEB"
                                TextColor="#B45309"
                                BorderColor="#FCD34D"
                                BorderWidth="1"
                                FontSize="12"
                                FontAttributes="Bold"
                                HeightRequest="40"
                                CornerRadius="8"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="RightColumn"
                                     Grid.Column="1"
                                     Spacing="12">

                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12"
                            Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="LEÍRÁS"
                                   FontSize="10"
                                   TextColor="#94A3B8"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.6"/>
                            <Label Text="{Binding SelectedTicket.Description}"
                                   FontSize="13"
                                   TextColor="#334155"
                                   LineBreakMode="WordWrap"/>

                            <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" Margin="0,4"/>

                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="ASSET AZONOSÍTÓ" FontSize="9" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                    <Label Text="{Binding SelectedTicket.AssetIdentifier, TargetNullValue='-'}"
                                           FontSize="12"
                                           TextColor="#2563EB"
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="HELYSZÍN" FontSize="9" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                    <Label Text="{Binding SelectedTicket.Location}"
                                           FontSize="12"
                                           TextColor="#0F172A"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="LÉTREHOZVA" FontSize="9" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                    <Label Text="{Binding SelectedTicket.CreatedAt, StringFormat='{0:yyyy.MM.dd HH:mm}'}"
                                           FontSize="12"
                                           TextColor="#475569"/>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12"
                            Padding="16">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="KOMMENTEK ÉS BEJEGYZÉSEK"
                                       FontSize="10"
                                       TextColor="#94A3B8"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.6"
                                       VerticalOptions="Center"/>
                                <Button Grid.Column="1"
                                        Text="↻ Frissítés"
                                        Command="{Binding LoadNotesCommand}"
                                        BackgroundColor="#F1F5F9"
                                        TextColor="#4F46E5"
                                        FontSize="11"
                                        FontAttributes="Bold"
                                        HeightRequest="28"
                                        Padding="10,0"
                                        CornerRadius="6"/>
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto"
                                  ColumnSpacing="8"
                                  IsVisible="{Binding CanAddNote}">
                                <Entry Grid.Column="0"
                                       Text="{Binding NewNote}"
                                       Placeholder="Új komment írása..."
                                       FontSize="12"
                                       MinimumHeightRequest="38"
                                       BackgroundColor="#F8FAFC"
                                       TextColor="#0F172A"/>
                                <Button Grid.Column="1"
                                        Text="Küldés"
                                        Command="{Binding AddNoteCommand}"
                                        BackgroundColor="#4F46E5"
                                        TextColor="White"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        HeightRequest="38"
                                        Padding="14,0"
                                        CornerRadius="8"/>
                            </Grid>

                            <CollectionView ItemsSource="{Binding Notes}"
                                            MaximumHeightRequest="190">
                                <CollectionView.EmptyView>
                                    <Label Text="Még nincs komment ehhez a hibajegyhez."
                                           FontSize="12"
                                           TextColor="#94A3B8"
                                           Margin="0,6"/>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#F8FAFC"
                                                Stroke="#E2E8F0"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="10,8"
                                                Margin="0,0,0,6">
                                            <VerticalStackLayout Spacing="3">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <Label Text="{Binding UserName}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="#0F172A"/>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding CreatedAt, StringFormat='{0:yyyy.MM.dd HH:mm}'}"
                                                           FontSize="10"
                                                           TextColor="#94A3B8"/>
                                                </Grid>
                                                <Label Text="{Binding Message}"
                                                       FontSize="12"
                                                       TextColor="#334155"
                                                       LineBreakMode="WordWrap"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12"
                            Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="STÁTUSZELŐZMÉNYEK"
                                   FontSize="10"
                                   TextColor="#94A3B8"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.6"/>

                            <CollectionView ItemsSource="{Binding StatusHistory}"
                                            MaximumHeightRequest="180">
                                <CollectionView.EmptyView>
                                    <HorizontalStackLayout Spacing="8">
                                        <Ellipse WidthRequest="6" Height="6" Fill="#4F46E5" VerticalOptions="Center"/>
                                        <Label Text="{Binding SelectedTicket.CreatedAt, StringFormat='{0:yyyy.MM.dd HH:mm} - Létrehozva'}"
                                               FontSize="12"
                                               TextColor="#475569"/>
                                    </HorizontalStackLayout>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#F8FAFC"
                                                Stroke="#E2E8F0"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="10,7"
                                                Margin="0,0,0,6">
                                            <VerticalStackLayout Spacing="2">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <Label Text="{Binding TransitionDisplay}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="#0F172A"/>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding CreatedAt, StringFormat='{0:yyyy.MM.dd HH:mm}'}"
                                                           FontSize="10"
                                                           TextColor="#94A3B8"/>
                                                </Grid>
                                                <Label Text="{Binding ChangedByUserName, StringFormat='Módosította: {0}'}"
                                                       FontSize="11"
                                                       TextColor="#64748B"/>
                                                <Label Text="{Binding Reason}"
                                                       FontSize="11"
                                                       TextColor="#475569"
                                                       LineBreakMode="WordWrap"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>