<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hibabejelento.Maui.Views.TicketDetailsPage"
             Title="Hibajegy részletei"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F6FA">

    <Grid Padding="20"
          VerticalOptions="Center"
          HorizontalOptions="Center">

        <Border BackgroundColor="White"
                Stroke="#E1E5EC"
                StrokeShape="RoundRectangle 16"
                Padding="0"
                WidthRequest="800"
                HeightRequest="560">

            <Grid RowDefinitions="Auto, *">

                <Grid Grid.Row="0" 
                      BackgroundColor="#4F46E5" 
                      Padding="20,15" 
                      ColumnDefinitions="*, Auto">

                    <Label Grid.Column="0"
                           Text="{Binding SelectedTicket.Title, StringFormat='Hibajegy Részletei: {0}'}" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="White" 
                           VerticalOptions="Center"/>

                    <Button Grid.Column="1"
                            Text="✕"
                            FontSize="16"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            HeightRequest="30"
                            WidthRequest="30"
                            Padding="0"
                            VerticalOptions="Center"/>
                </Grid>

                <Grid Grid.Row="1" 
                      ColumnDefinitions="1.1*, 1.9*" 
                      Padding="25" 
                      ColumnSpacing="20">

                    <VerticalStackLayout Grid.Column="0" Spacing="12">

                        <Border BackgroundColor="#F9FAFB" Stroke="#E5E7EB" StrokeShape="RoundRectangle 8" Padding="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Azonosító:" FontSize="11" TextColor="#6B7280" FontAttributes="Bold"/>
                                <Label Text="{Binding SelectedTicket.TicketNumber}" FontSize="14" TextColor="#1F2937" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="#F9FAFB" Stroke="#E5E7EB" StrokeShape="RoundRectangle 8" Padding="12">
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Státusz:" FontSize="11" TextColor="#6B7280" FontAttributes="Bold"/>
                                    <Label Text="{Binding SelectedTicket.Status}" FontSize="13" TextColor="#1F2937"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="1" BackgroundColor="#DCFCE7" Padding="8,4" StrokeShape="RoundRectangle 4" VerticalOptions="Center">
                                    <Label Text="{Binding SelectedTicket.Status}" FontSize="11" TextColor="#166534" FontAttributes="Bold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border BackgroundColor="#F9FAFB" Stroke="#E5E7EB" StrokeShape="RoundRectangle 8" Padding="12">
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Prioritás:" FontSize="11" TextColor="#6B7280" FontAttributes="Bold"/>
                                    <Label Text="{Binding SelectedTicket.Priority}" FontSize="13" TextColor="#1F2937"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="1" BackgroundColor="#FEE2E2" Padding="8,4" StrokeShape="RoundRectangle 4" VerticalOptions="Center">
                                    <Label Text="{Binding SelectedTicket.Priority}" FontSize="11" TextColor="#991B1B" FontAttributes="Bold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border BackgroundColor="#F9FAFB" Stroke="#E5E7EB" StrokeShape="RoundRectangle 8" Padding="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Bejelentő ID:" FontSize="11" TextColor="#6B7280" FontAttributes="Bold"/>
                                <Label Text="{Binding SelectedTicket.ReporterId, StringFormat='#USER-{0}'}" FontSize="13" TextColor="#1F2937"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="#F9FAFB" Stroke="#E5E7EB" StrokeShape="RoundRectangle 8" Padding="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Határidő:" FontSize="11" TextColor="#6B7280" FontAttributes="Bold"/>
                                <Label Text="{Binding SelectedTicket.DueDate, StringFormat='{0:yyyy-MM-dd}'}" FontSize="13" TextColor="#1F2937"/>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="12">

                        <Border BackgroundColor="#F9FAFB" Stroke="#E5E7EB" StrokeShape="RoundRectangle 8" Padding="15">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Leírás:" FontSize="12" TextColor="#6B7280" FontAttributes="Bold"/>
                                <Label Text="{Binding SelectedTicket.Description}" FontSize="13" TextColor="#1F2937" LineBreakMode="WordWrap"/>

                                <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,6,0,6"/>

                                <Label Text="Asset Azonosító:" FontSize="11" TextColor="#6B7280" FontAttributes="Bold"/>
                                <Label Text="{Binding SelectedTicket.AssetIdentifier}" FontSize="12" TextColor="#2563EB" FontAttributes="Bold"/>

                                <Label Text="Helyszín:" FontSize="11" TextColor="#6B7280" FontAttributes="Bold" Margin="0,4,0,0"/>
                                <Label Text="{Binding SelectedTicket.Location}" FontSize="12" TextColor="#1F2937"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="#F9FAFB" Stroke="#E5E7EB" StrokeShape="RoundRectangle 8" Padding="15" HeightRequest="160">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Eseménynapló:" FontSize="12" TextColor="#6B7280" FontAttributes="Bold"/>

                                <ScrollView>
                                    <VerticalStackLayout Spacing="8">
                                        <HorizontalStackLayout Spacing="8">
                                            <Ellipse WidthRequest="6" HeightRequest="6" Fill="#9CA3AF" VerticalOptions="Center"/>
                                            <Label Text="{Binding SelectedTicket.CreatedAt, StringFormat='{0:yyyy-MM-dd HH:mm} - Létrehozva'}" FontSize="12" TextColor="#4B5563"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </ScrollView>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                </Grid>

            </Grid>

        </Border>

    </Grid>
</ContentPage>