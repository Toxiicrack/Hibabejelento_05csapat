<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hibabejelento.Maui.Views.TicketDetailsPage"
             Title="Hibajegy részletei"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#EEF2F6">

    <Grid Padding="24"
          VerticalOptions="Center"
          HorizontalOptions="Center">

        <Border BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 20"
                Padding="0"
                WidthRequest="840"
                HeightRequest="600"
                Shadow="{Shadow Brush='#10000000', Offset='0,10', Radius=25}">

            <Grid RowDefinitions="Auto, *">

                <Grid Grid.Row="0" 
                      BackgroundColor="#4F46E5" 
                      Padding="24,18" 
                      ColumnDefinitions="*, Auto">

                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <Label Text="{Binding SelectedTicket.TicketNumber, StringFormat='{0}'}" 
                               FontSize="17" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation"/>
                    </HorizontalStackLayout>

                    <Button Grid.Column="1"
                            Text="✕"
                            Command="{Binding CloseCommand}"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#A5B4FC"
                            BackgroundColor="Transparent"
                            HeightRequest="36"
                            WidthRequest="36"
                            Padding="0"
                            CornerRadius="18"
                            VerticalOptions="Center"/>
                </Grid>

                <Grid Grid.Row="1" 
                      ColumnDefinitions="1.1*, 1.9*" 
                      Padding="28" 
                      ColumnSpacing="24">

                    <VerticalStackLayout Grid.Column="0" Spacing="10">

                        <Border BackgroundColor="#F8FAFC" Stroke="#F1F5F9" StrokeShape="RoundRectangle 10" Padding="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="AZONOSÍTÓ" FontSize="10" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                <Label Text="{Binding SelectedTicket.TicketNumber}" FontSize="13" TextColor="#0F172A" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="#F8FAFC" Stroke="#F1F5F9" StrokeShape="RoundRectangle 10" Padding="12">
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="STÁTUSZ" FontSize="10" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                    <Label Text="{Binding SelectedTicket.Status}" FontSize="13" TextColor="#0F172A"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="1" BackgroundColor="#DCFCE7" Padding="10,4" StrokeShape="RoundRectangle 6" Stroke="Transparent" VerticalOptions="Center">
                                    <Label Text="{Binding SelectedTicket.Status}" FontSize="11" TextColor="#166534" FontAttributes="Bold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border BackgroundColor="#F8FAFC" Stroke="#F1F5F9" StrokeShape="RoundRectangle 10" Padding="12">
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="PRIORITÁS" FontSize="10" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                    <Label Text="{Binding SelectedTicket.Priority}" FontSize="13" TextColor="#0F172A"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="1" BackgroundColor="#FEE2E2" Padding="10,4" StrokeShape="RoundRectangle 6" Stroke="Transparent" VerticalOptions="Center">
                                    <Label Text="{Binding SelectedTicket.Priority}" FontSize="11" TextColor="#991B1B" FontAttributes="Bold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border BackgroundColor="#F8FAFC" Stroke="#F1F5F9" StrokeShape="RoundRectangle 10" Padding="12">
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="KATEGÓRIA" FontSize="10" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                    <Label Text="{Binding SelectedTicket.CategoryName}" FontSize="13" TextColor="#0F172A" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="1" BackgroundColor="#E0E7FF" Padding="10,4" StrokeShape="RoundRectangle 6" Stroke="Transparent" VerticalOptions="Center">
                                    <Label Text="Kategória" FontSize="11" TextColor="#3730A3" FontAttributes="Bold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Border Grid.Column="0" BackgroundColor="#F8FAFC" Stroke="#F1F5F9" StrokeShape="RoundRectangle 10" Padding="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="BEJELENTŐ" FontSize="9" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                    <Label Text="{Binding SelectedTicket.ReporterId, StringFormat='#USER-{0}'}" FontSize="12" TextColor="#0F172A"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#F1F5F9" StrokeShape="RoundRectangle 10" Padding="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="HATÁRIDŐ" FontSize="9" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                    <Label Text="{Binding SelectedTicket.DueDate, StringFormat='{0:yyyy-MM-dd}'}" FontSize="12" TextColor="#0F172A"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Button Text="Hibajegy visszavonása"
                                Command="{Binding WithdrawTicketCommand}"
                                IsVisible="{Binding CanWithdraw}"
                                BackgroundColor="#FEF2F2"
                                TextColor="#DC2626"
                                BorderColor="#FCA5A5"
                                BorderWidth="1"
                                FontSize="12"
                                FontAttributes="Bold"
                                HeightRequest="38"
                                CornerRadius="8"
                                Margin="0,4,0,0"/>

                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="12">

                        <Border BackgroundColor="#F8FAFC" Stroke="#F1F5F9" StrokeShape="RoundRectangle 10" Padding="16">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="LEÍRÁS" FontSize="10" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                <Label Text="{Binding SelectedTicket.Description}" FontSize="13" TextColor="#334155" LineBreakMode="WordWrap"/>

                                <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" Margin="0,8,0,8"/>

                                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="ASSET AZONOSÍTÓ" FontSize="9" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                        <Label Text="{Binding SelectedTicket.AssetIdentifier}" FontSize="12" TextColor="#2563EB" FontAttributes="Bold"/>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="HELYSZÍN" FontSize="9" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                        <Label Text="{Binding SelectedTicket.Location}" FontSize="12" TextColor="#0F172A"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="#F8FAFC" Stroke="#F1F5F9" StrokeShape="RoundRectangle 10" Padding="16" HeightRequest="155">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="ESEMÉNYNAPLÓ" FontSize="10" TextColor="#94A3B8" FontAttributes="Bold" CharacterSpacing="0.5"/>

                                <ScrollView>
                                    <VerticalStackLayout Spacing="8">
                                        <HorizontalStackLayout Spacing="8">
                                            <Ellipse WidthRequest="6" Height="6" Fill="#4F46E5" VerticalOptions="Center"/>
                                            <Label Text="{Binding SelectedTicket.CreatedAt, StringFormat='{0:yyyy-MM-dd HH:mm} - Létrehozva'}" FontSize="12" TextColor="#475569"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </ScrollView>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                </Grid>

            </Grid>

        </Border>

    </Grid>
</ContentPage>